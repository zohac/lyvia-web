{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": ".tmp/test-dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "app/features/availability/domain/**/*.ts",
    "app/features/availability/api/availability.contract.ts",
    "app/features/consultation/domain/**/*.ts",
    "tests/types/**/*.d.ts",
    "tests/**/*.ts"
  ]
}
