{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": ".tmp/test-dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "app/features/availability/domain/**/*.ts",
    "app/features/availability/api/availability.contract.ts",
    "app/features/consultation/domain/**/*.ts",
    "app/features/public/domain/**/*.ts",
    "app/features/analytics/helpers/**/*.ts",
    "app/features/analytics/api/**/*.ts",
    "shared/utils/**/*.ts",
    "app/utils/**/*.ts",
    "app/services/api/api-error.ts",
    "app/services/api/contracts/error-response.ts",
    "tests/types/**/*.d.ts",
    "tests/**/*.ts"
  ]
}
