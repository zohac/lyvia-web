{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": ".tmp/test-dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["app/*"]
    }
  },
  "include": [
    "app/features/availability/domain/**/*.ts",
    "app/features/availability/api/availability.contract.ts",
    "app/features/consultation/domain/**/*.ts",
    "app/features/public/domain/**/*.ts",
    "app/features/analytics/helpers/**/*.ts",
    "app/features/analytics/api/**/*.ts",
    "app/features/seo/schema-helpers.ts",
    "app/features/seo/b2c-landing-schema-helpers.ts",
    "app/features/seo/api/featured-provider.contract.ts",
    "app/features/waitlist/**/*.ts",
    "app/features/seo/api/public-provider-profile.contract.ts",
    "shared/utils/**/*.ts",
    "app/utils/**/*.ts",
    "app/composables/useCoachLink.ts",
    "app/composables/coach-template-registry.ts",
    "app/composables/useCoachSectionVisibility.ts",
    "app/plugins/microsoft-clarity-helpers.ts",
    "app/plugins/microsoft-clarity-runtime.ts",
    "app/services/api/api-error.ts",
    "app/services/api/contracts/error-response.ts",
    "tests/types/**/*.d.ts",
    "tests/**/*.ts"
  ]
}
