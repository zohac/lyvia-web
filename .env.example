# =============================================================================
# Lyvia Web - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Variables prefixed with NUXT_PUBLIC_ are exposed to the browser.
# Variables prefixed with NUXT_ (without PUBLIC) are server-only.
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------

# Browser-side API base URL (relative path, proxied by Nitro)
NUXT_PUBLIC_API_BASE_URL=/api

# Server-side API upstream URL (used by Nitro proxy to forward requests)
# In Docker: http://api:3001 | In production: https://your-api-domain.com
NUXT_API_BASE_URL=http://api:3001

# -----------------------------------------------------------------------------
# Tenant / Platform Configuration
# -----------------------------------------------------------------------------

# Platform domain for tenant resolution.
# Requests from this domain (or subdomains) show the marketing landing page.
# Other domains are treated as white-label coach sites.
# Examples: keova.fr (production) | lyvia-web.vercel.app (staging)
NUXT_PUBLIC_PLATFORM_DOMAIN=keova.fr

# -----------------------------------------------------------------------------
# Stripe (Payments)
# -----------------------------------------------------------------------------

# Stripe publishable key (client-side, for Stripe.js/Elements)
# Get from: https://dashboard.stripe.com/apikeys
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx


# -----------------------------------------------------------------------------
# Observability (Optional)
# -----------------------------------------------------------------------------

# Sentry DSN for error tracking (leave empty to disable)
# Get from: https://sentry.io/settings/projects/xxx/keys/
NUXT_PUBLIC_SENTRY_DSN=
