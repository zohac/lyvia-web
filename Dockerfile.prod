# ---- Stage 1: Install dependencies ----
FROM node:20-alpine AS deps

WORKDIR /app

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable && corepack prepare pnpm@10.23.0 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# ---- Stage 2: Build ----
FROM deps AS build

# Build-time env vars (will be baked into the client bundle)
ARG NUXT_PUBLIC_API_BASE_URL=/api
ARG NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY

ENV NUXT_PUBLIC_API_BASE_URL=$NUXT_PUBLIC_API_BASE_URL
ENV NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=$NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY

COPY . .
RUN pnpm build

# ---- Stage 3: Production image ----
FROM node:20-alpine AS production

WORKDIR /app

ENV NODE_ENV=production

# Nitro server output
COPY --from=build /app/.output ./.output

RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

# Scalingo injects $PORT dynamically, Nitro uses it automatically
EXPOSE ${PORT:-3000}

CMD ["node", ".output/server/index.mjs"]
