    "lint": "eslint .",
    "test": "pnpm test:unit",
    "test:unit": "tsc -p tsconfig.tests.json && node -e \"require('fs').writeFileSync('.tmp/test-dist/package.json', '{\\\\\\\"type\\\\\\\":\\\\\\\"commonjs\\\\\\\"}')\" && node --test .tmp/test-dist/tests/**/*.test.js",
    "typecheck": "nuxt typecheck",
    "contract:check": "node ./scripts/contract-check-openapi-auth.mjs"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.100",
    "@iconify-json/simple-icons": "^1.2.59",
    "@nuxt/content": "^3.13.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.6.0",
    "@nuxtjs/critters": "^0.9.0",
    "@nuxtjs/seo": "^3.4.0",
    "better-sqlite3": "^12.9.0",
    "nuxt": "^4.4.2"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.10.0",
    "@tailwindcss/vite": "^4.2.2",
    "eslint": "^9.39.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.1.5"
  },
  "packageManager": "pnpm@10.23.0",
  "pnpm": {
    "overrides": {
      "flatted": ">=3.4.2",
      "minimatch": ">=3.1.4",
      "fast-xml-parser": ">=5.5.6",
      "svgo": ">=4.0.1",
